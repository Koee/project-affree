{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "node16",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "rootDir": ".",
        "types": [
            "node"
        ],
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true
    },
    "include": [
        "fixtures/**/*.ts",
        "utils/**/*.ts",
        "tests/**/*.ts",
        "schemas/**/*.ts",
        "playwright.config.ts",
        "components/location.component.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}